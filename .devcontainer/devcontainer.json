// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-in-docker
{
	"name": "Docker in Docker Development",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/base:bullseye",

	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {
			"version": "latest",
			"enableNonRootDocker": "true",
			"moby": "true"
		},
		"ghcr.io/devcontainers/features/aws-cli:1": {},
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/devcontainers/features/python:1": {},
		"ghcr.io/devcontainers/features/node:1": {
			"version": "20",
			"nodeGypDependencies": true
		}
	},

	"mounts": [
		"source=${localWorkspaceFolder}/APPCONFIG.env,target=${localWorkspaceFolder}/APPCONFIG.env,type=bind"
	],

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// Note: This should match the LOCAL_PORT value in APPCONFIG.env (default: 8000)
	// If you change LOCAL_PORT in APPCONFIG.env, update this value accordingly.
	"forwardPorts": [8000],
	"portsAttributes": {
		"8000": {
			"label": "Django Development Server",
			"onAutoForward": "notify"
		}
	},

	// Use 'postCreateCommand' to run commands after the container is created.
	"postCreateCommand": "npm install -g aws-cdk && pip install -r requirements-dev.txt && chmod +x ${containerWorkspaceFolder}/.devcontainer/setup-env.sh",

	"customizations": {
		"vscode": {
			"extensions": [
				"ms-azuretools.vscode-docker",
				"ms-vscode-remote.remote-containers"
			]
		}
	},

	// Connect as non-root user
	"remoteUser": "vscode",

	// Ensure Docker socket has correct permissions
	"initializeCommand": "",

	// Run commands after container is created
	"postStartCommand": "bash -c '${containerWorkspaceFolder}/.devcontainer/setup-env.sh'",

	// Run commands after container is attached
	"postAttachCommand": "bash -c 'source ~/.bashrc'"

}
