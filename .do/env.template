# DigitalOcean App Platform Environment Variables Template
# Copy this file to .env and fill in your values

# Django Configuration
DJANGO_SECRET_KEY=your-django-secret-key-here
DJANGO_SUPERUSER_EMAIL=admin@your-domain.com
DJANGO_SUPERUSER_PASSWORD=your-admin-password

# Database Configuration (automatically set by DigitalOcean managed database)
# These placeholders are replaced by DO App Platform
DB_HOST=${db.HOSTNAME}
DB_PORT=${db.PORT}
DB_NAME=${db.DATABASE}
DB_USER=${db.USERNAME}
DB_PASSWORD=${db.PASSWORD}

# CSRF Trusted Origins (will be set automatically to your app domain)
CSRF_TRUSTED_ORIGINS=https://sailarchive-xxxxx.ondigitalocean.app

# DigitalOcean Spaces (required for track file storage)
# Get these from: DigitalOcean Dashboard -> API -> Spaces Keys
DO_SPACES_KEY=your-spaces-access-key
DO_SPACES_SECRET=your-spaces-secret-key
DO_SPACES_NAME=sailarchive-tracks
DO_SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
DO_SPACES_REGION=sfo3

# Email Configuration (optional - for password reset, etc.)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-brevo-username@smtp-brevo.com
EMAIL_HOST_PASSWORD=your-brevo-password
DEFAULT_FROM_EMAIL=noreply@sailarchive.com
